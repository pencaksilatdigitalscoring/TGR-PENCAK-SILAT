        .stamina-item { background: #fff; border: 2px solid #ddd; padding: 12px 2px; border-radius: 8px; text-align: center; cursor: pointer; font-weight: 700; font-size: 0.85rem; transition: 0.2s; font-variant-numeric: tabular-nums; }
