        function selectJuri(juriId) {
            if(juriStatusData['juri'+juriId] === true) { alert("⚠️ JURI " + juriId + " SEDANG LOGIN."); return; }
            
            // Auto landscape upon entering Juri Mode
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().then(() => {
                    if (screen.orientation && screen.orientation.lock) {
                        screen.orientation.lock('landscape').catch(e => {});
                    }
                }).catch(err => console.log("Fullscreen request denied", err));
            } else {
                if (screen.orientation && screen.orientation.lock) {
                    screen.orientation.lock('landscape').catch(e => {});
                }
            }

            db.ref('juriStatus/juri' + juriId).set(true);
            activeJuriId = juriId;
            document.getElementById('active-juri-label').innerText = "SCORING JURI " + juriId;
            db.ref('scores/juri' + juriId).once('value').then((snap) => {
                let defaultScore = currentJuriMode === 'tunggal' ? 9.90 : 9.10;
                const data = snap.val() || { penalty: 0, jurus: 1, stamina: 0, kekayaan: 0, kebenaran: 0, score: defaultScore };
                
                currentWrongCount = Math.round((data.penalty || 0) / 0.01);
                currentJurusCount = data.jurus || 1;
                document.getElementById('wrong-count').innerText = (data.penalty || 0).toFixed(2);
                document.getElementById('jurus-count').innerText = currentJurusCount;
                
                if (currentJuriMode === 'tunggal') {
                    document.getElementById('mode-tunggal-ui').style.display = 'block';
                    document.getElementById('mode-ganda-ui').style.display = 'none';
                    document.getElementById('penalty-box').style.display = '';
                    document.getElementById('btn-wrong').style.display = '';
                    document.getElementById('jurus-box').style.display = '';
                    document.getElementById('btn-next').style.display = '';
                    
                    document.querySelectorAll('#mode-tunggal-ui .stamina-item').forEach(item => {
                        item.classList.remove('active');
                        if(parseFloat(item.innerText) === (data.stamina || 0)) item.classList.add('active');
                    });
                } else {
                    document.getElementById('mode-tunggal-ui').style.display = 'none';
                    document.getElementById('mode-ganda-ui').style.display = 'flex';
                    document.getElementById('penalty-box').style.display = 'none';
                    document.getElementById('btn-wrong').style.display = 'none';
                    document.getElementById('jurus-box').style.display = 'none';
                    document.getElementById('btn-next').style.display = 'none';
                    
                    gandaVals.kekayaan = data.kekayaan || 0;
                    gandaVals.kebenaran = data.kebenaran || 0;
                    gandaVals.stamina = data.stamina || 0;
                    
                    document.querySelectorAll('#grid-kekayaan .stamina-item').forEach(item => {
                        item.classList.remove('active');
                        if(parseFloat(item.innerText) === gandaVals.kekayaan) item.classList.add('active');
                    });
                    document.querySelectorAll('#grid-kebenaran .stamina-item').forEach(item => {
                        item.classList.remove('active');
                        if(parseFloat(item.innerText) === gandaVals.kebenaran) item.classList.add('active');
                    });
                    document.querySelectorAll('#grid-stamina-ganda .stamina-item').forEach(item => {
                        item.classList.remove('active');
                        if(parseFloat(item.innerText) === gandaVals.stamina) item.classList.add('active');
                    });
                }
                
                calculateJuriScore();
                showPage('juri-scoring-section');
            });
        }

