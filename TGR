    <script>
        // LOGIC UNTUK LOGIN
        function processLogin() {
            const user = document.getElementById('login-user').value;
            const pass = document.getElementById('login-pass').value;
            
            if(user === 'admin' && pass === '1234') {
                document.getElementById('login-section').style.display = 'none';
                document.getElementById('main-app').style.display = 'flex';
                // Reset input jika diperlukan
                document.getElementById('login-user').value = '';
                document.getElementById('login-pass').value = '';
            } else {
                alert('Username atau Password salah!');
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            // Event listener untuk tombol Enter pada password field
            const passInput = document.getElementById('login-pass');
            if(passInput) {
                passInput.addEventListener('keypress', function(e) {
                    if(e.key === 'Enter') processLogin();
                });
            }

            // Inisialisasi ganda grid yang ada sebelumnya
            let htmlKekayaan = '';
            let htmlKebenaran = '';
            let htmlStaminaG = '';
            for(let i=1; i<=30; i++) {
                let val = (i/100).toFixed(2);
                htmlKekayaan += `<div class="stamina-item" onclick="toggleGandaItem(this, 'kekayaan')">${val}</div>`;
                htmlKebenaran += `<div class="stamina-item" onclick="toggleGandaItem(this, 'kebenaran')">${val}</div>`;
                htmlStaminaG += `<div class="stamina-item" onclick="toggleGandaItem(this, 'stamina')">${val}</div>`;
            }
            document.getElementById('grid-kekayaan').innerHTML = htmlKekayaan;
            document.getElementById('grid-kebenaran').innerHTML = htmlKebenaran;
            document.getElementById('grid-stamina-ganda').innerHTML = htmlStaminaG;
        });

        // FIREBASE INITIALIZATION
        const firebaseConfig = {
            apiKey: "AIzaSyB1MHdbvioQaeyh0wRwb279UTIxMyLZKVw",
            authDomain: "uji-coba-2-ad2ef.firebaseapp.com",
            databaseURL: "https://uji-coba-2-ad2ef-default-rtdb.asia-southeast1.firebasedatabase.app",
            projectId: "uji-coba-2-ad2ef",
            storageBucket: "uji-coba-2-ad2ef.firebasestorage.app",
            messagingSenderId: "326062820861",
            appId: "1:326062820861:web:353cd3c548c492f29e1d94"
        };
        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();

        let currentWrongCount = 0;
        let currentJurusCount = 1; 
        let penaltyDewan = 0.00;
        let finalScoreValue = 0.000;
        let activeJuriId = null;
        let currentSekPageNum = 1;
        let globalStDev = 0;
        let globalMedian = 0;
        let juriStatusData = {};
        
        let currentJuriMode = 'tunggal';
        let gandaVals = { kekayaan: 0, kebenaran: 0, stamina: 0 };
        let prevPinaltyStates = {};

        // Timer Variables
        let startTime;
        let elapsedTime = 0;
        let timerInterval;

        // Global Data Store
        let globalMatchData = [];
        let globalRekapData = [];
        let activeMatchInfo = { partai: 0, side: '', name: '', cont: '', kategori: '', img: '' };

        function setOpsiJuri(opsi) {
            currentJuriMode = opsi;
            document.getElementById('btn-opsi-tunggal').classList.remove('active');
            document.getElementById('btn-opsi-ganda').classList.remove('active');
            
            if (opsi === 'tunggal') {
                document.getElementById('btn-opsi-tunggal').classList.add('active');
            } else {
                document.getElementById('btn-opsi-ganda').classList.add('active');
            }
        }

        function toggleGandaItem(el, type) {
            const parent = el.parentElement;
            const wasActive = el.classList.contains('active');
            parent.querySelectorAll('.stamina-item').forEach(item => item.classList.remove('active'));
            if (!wasActive) {
                el.classList.add('active');
                gandaVals[type] = parseFloat(el.innerText);
            } else {
                gandaVals[type] = 0;
            }
            calculateJuriScore();
        }

        // INITIAL SYNC FROM FIREBASE
        db.ref('matches').on('value', (snapshot) => {
            const data = snapshot.val();
            if(data) {
                globalMatchData = Object.keys(data).map(key => ({ partai: key, ...data[key] }));
            } else {
                globalMatchData = [];
            }
            const sekSec = document.getElementById('sekretaris-section');
            if(sekSec.style.display === 'block') renderSekretaris();
            if(document.getElementById('operator-section').style.display === 'block') renderOperatorTable();
            if(document.getElementById('jadwal-section').style.display === 'block') renderJadwal();
            if(document.getElementById('loting-section').style.display === 'block') renderLotingDaftar();
        });

        db.ref('juriStatus').on('value', (snapshot) => {
            juriStatusData = snapshot.val() || {};
            renderJuriSelection();
            updateJuriStatusInDewan();
            updateJuriStatusInScoreboard(); 
            updateOutJuriModalColors(); 
            
            // RESPONSIF LOGOUT
            if (activeJuriId !== null && juriStatusData['juri' + activeJuriId] !== true) {
                activeJuriId = null;
                if (document.fullscreenElement) {
                    document.exitFullscreen().catch(e => {});
                }
                if (screen.orientation && screen.orientation.unlock) {
                    screen.orientation.unlock();
                }
                showPage('juri-selection-section');
            }

            db.ref('scores').once('value', (snap) => {
                calculateGlobalScores(snap.val());
            });
        });

        db.ref('rekap').on('value', (snapshot) => {
            const data = snapshot.val();
            globalRekapData = data ? Object.keys(data).map(key => ({id: key, ...data[key]})) : [];
            if(document.getElementById('rekap-section').style.display === 'block') renderRekap();
        });

        db.ref('activeMatch').on('value', (snapshot) => {
            const val = snapshot.val();
            if(val) {
                activeMatchInfo = val;
                updateUIAfterLoad();
            }
        });

        db.ref('timer').on('value', (snapshot) => {
            const val = snapshot.val();
            if(val) {
                elapsedTime = val.elapsedTime;
                updateTimerDisplays(elapsedTime);
                if(val.isRunning) {
                    if(!timerInterval) {
                        startTime = Date.now() - elapsedTime;
                        timerInterval = setInterval(() => {
                            elapsedTime = Date.now() - startTime;
                            updateTimerDisplays(elapsedTime);
                        }, 10);
