<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <!-- Kunci Zoom: user-scalable=no agar halaman tidak dapat di-zoom -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Digital Scoring Pencak Silat TGR</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Firebase SDK (Compatibility Version) -->
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-database-compat.js"></script>

    <!-- Export & Import Libraries -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <!-- PDF.js for Importing PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>

    <style>
        :root {
            --primary-color: #007bff;
            --secondary-color: #00d2ff;
            --bg-color: #f0f4f8;
            --card-bg: #ffffff;
            --text-main: #2d3436;
            --text-sub: #636e72;
            --success: #27ae60;
            --danger: #e74c3c;
            --warning: #f1c40f;
            --info: #8e44ad;
            --dark: #2d3436;
            --shadow: 0 10px 20px rgba(0,0,0,0.05);
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            touch-action: manipulation;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* LOGIN PAGE STYLING */
        #login-section {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            background-color: #000;
        }
        .login-bg-video {
            position: absolute;
            top: 50%; left: 50%;
            min-width: 100%; min-height: 100%;
            width: auto; height: auto;
            transform: translate(-50%, -50%);
            object-fit: cover;
            z-index: -2;
        }
        .login-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: -1;
        }
        .login-box {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            padding: 40px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            text-align: center;
            color: white;
            box-shadow: 0 15px 35px rgba(0,0,0,0.3);
            width: 90%;
            max-width: 420px;
            animation: fadeIn 1s ease;
        }
        .login-box h2 {
            font-size: 1.6rem;
            margin-bottom: 5px;
            font-weight: 700;
            color: var(--secondary-color);
            text-transform: uppercase;
            letter-spacing: 1px;
            text-shadow: 0 2px 5px rgba(0,0,0,0.3);
        }
        .login-box .subtitle {
            font-size: 0.85rem;
            opacity: 0.9;
            margin-bottom: 20px;
            text-transform: capitalize;
        }
        .login-box .welcome-text {
            font-size: 0.95rem;
            margin-bottom: 25px;
            font-weight: 600;
            color: #fff;
        }
        .login-box .input-group {
            position: relative;
            margin-bottom: 15px;
        }
        .login-box .input-group i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255,255,255,0.7);
        }
        .login-box input {
            width: 100%;
            padding: 12px 12px 12px 40px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.3);
            background: rgba(0,0,0,0.2);
            color: white;
            font-family: 'Poppins', sans-serif;
            font-size: 0.9rem;
            outline: none;
            transition: all 0.3s;
        }
        .login-box input::placeholder {
            color: rgba(255,255,255,0.7);
        }
        .login-box input:focus {
            background: rgba(0,0,0,0.4);
            border-color: var(--secondary-color);
            box-shadow: 0 0 10px rgba(0, 210, 255, 0.3);
        }
        .btn-login {
            width: 100%;
            padding: 12px;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border: none;
            border-radius: 10px;
            color: white;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            margin-top: 10px;
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 123, 255, 0.4);
        }
        .btn-login:active {
            transform: translateY(0);
        }

        #main-app {
            display: none;
            flex-direction: column;
            width: 100%;
            flex-grow: 1;
        }

        /* Header Styling */
        header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            padding: 15px;
            color: white;
            text-align: center;
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            margin-bottom: 15px;
        }

        header h1 { font-size: 1.2rem; font-weight: 700; text-transform: uppercase; }
        header p { font-size: 0.7rem; opacity: 0.9; }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 10px 20px 10px;
            width: 100%;
            flex-grow: 1;
        }

        /* Navigasi Buttons */
        .back-btn {
            background: #fff;
            border: none;
            padding: 8px 12px;
            border-radius: 8px;
            margin-bottom: 10px;
            cursor: pointer;
            font-weight: 600;
            color: var(--primary-color);
            box-shadow: var(--shadow);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.8rem;
        }

        .btn-landscape {
            background: var(--text-main);
            color: white;
            border: none;
            padding: 8px 12px;
            border-radius: 8px;
            margin-bottom: 10px;
            margin-left: 5px;
            cursor: pointer;
            font-weight: 600;
            box-shadow: var(--shadow);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.8rem;
        }

        /* SEKSI HALAMAN */
        .page-section { display: none; animation: fadeIn 0.4s ease; }
        #main-menu-section { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* GRID MENU UTAMA */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 12px;
        }

        .menu-card {
            background: var(--card-bg);
            border-radius: 12px;
            padding: 15px;
            text-align: center;
            box-shadow: var(--shadow);
            transition: var(--transition);
            cursor: pointer;
            border: 1px solid rgba(0,0,0,0.05);
            position: relative;
        }

        .menu-card:hover { transform: translateY(-5px); border-color: var(--primary-color); }
        .menu-card i { font-size: 1.8rem; margin-bottom: 8px; color: var(--primary-color); }
        .menu-card h3 { font-size: 0.8rem; }

        /* Status Dot Indicator for Juri */
        .status-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
            margin-bottom: 8px;
        }
        .dot-online { background-color: var(--success); box-shadow: 0 0 8px var(--success); }
        .dot-offline { background-color: var(--danger); box-shadow: 0 0 8px var(--danger); }
        .menu-card.locked { border: 2px solid var(--danger); }

        /* PANEL UMUM */
        .panel { background: white; border-radius: 15px; padding: 15px; box-shadow: var(--shadow); }
        .panel-title { margin-bottom: 15px; font-size: 1rem; color: var(--primary-color); border-left: 4px solid var(--primary-color); padding-left: 10px; }

        /* OPSI JURI TOGGLE BUTTONS */
        .btn-opsi-juri {
            flex: 1;
            padding: 12px;
            border: 2px solid var(--primary-color);
            border-radius: 10px;
            background: white;
            color: var(--primary-color);
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            font-size: 0.8rem;
        }
        .btn-opsi-juri.active {
            background: var(--primary-color);
            color: white;
            box-shadow: 0 0 15px rgba(0, 123, 255, 0.5);
        }

        /* STYLING DEWAN */
        .dewan-profile-wrapper {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f1f7ff;
            padding: 15px;
            border-radius: 12px;
            margin-bottom: 15px;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.02);
        }
        .dewan-info-side {
            text-align: left;
        }
        .dewan-avatar-side {
            width: 90px;
            height: 90px;
            border-radius: 10px;
            border: 3px solid var(--primary-color);
            overflow: hidden;
            box-shadow: var(--shadow);
        }
        .dewan-avatar-side img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .dewan-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
            font-size: 0.7rem;
            text-align: center;
            box-shadow: var(--shadow);
            border-radius: 8px;
            overflow: hidden;
        }
        .dewan-table th, .dewan-table td {
            padding: 8px 4px;
            border: 1px solid #ddd;
        }
        .dewan-table th {
            color: white;
            text-transform: uppercase;
        }
        .dewan-table .bg-dark {
            background-color: #2d3436 !important;
            color: white;
            font-weight: 700;
        }
        .dewan-table .side-header-merah { background-color: var(--danger); }
        .dewan-table .side-header-biru { background-color: var(--primary-color); }
        
        /* STYLING SEKRETARIS */
        .sek-top-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 20px;
        }
        .match-card {
            background: #fff;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            border: 1px solid #eee;
        }
        .match-header-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--bg-color);
            flex-wrap: wrap;
            gap: 10px;
        }
        .match-title { font-weight: 700; color: var(--primary-color); font-size: 1rem; margin-bottom: 5px; }
        
        .side-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }
        @media (max-width: 768px) {
            .side-container { grid-template-columns: 1fr; }
        }

        .side-box {
            padding: 12px;
            border-radius: 10px;
            position: relative;
        }
        .side-merah { background-color: #fff5f5; border: 1px solid #feb2b2; }
        .side-biru { background-color: #f0f9ff; border: 1px solid #90cdf4; }
        
        .side-label {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 10px;
            display: block;
        }
        .side-merah .side-label { color: var(--danger); }
        .side-biru .side-label { color: var(--primary-color); }

        .sek-form-group { margin-bottom: 10px; }
        .sek-form-group label { display: block; font-size: 0.65rem; font-weight: 600; color: var(--text-sub); margin-bottom: 4px; }
        .sek-form-group input, .sek-form-group select {
            width: 100%;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 0.8rem;
            font-family: 'Poppins', sans-serif;
        }

        /* Upload Photo Styling */
        .upload-wrapper {
            margin-top: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.5);
            padding: 8px;
            border-radius: 8px;
        }
        .img-prev-sek {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #ddd;
            background: #fff;
        }
        .input-file-custom {
            font-size: 0.6rem;
            width: 100%;
            color: var(--text-sub);
        }

        .pagination-bar {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            margin-top: 20px;
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: var(--shadow);
        }
        .pg-btn {
            background: var(--primary-color);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: 0.3s;
        }
        .pg-btn:disabled { background: #ccc; cursor: not-allowed; }
        .pg-info { font-size: 0.85rem; font-weight: 600; }

        /* ATHLETE INFO RINGKAS */
        .athlete-info { background: #f1f7ff; padding: 12px; border-radius: 12px; margin-bottom: 12px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
        .info-item label { display: block; font-size: 0.6rem; color: var(--text-sub); font-weight: 700; text-transform: uppercase; }
        .info-item p { font-size: 0.75rem; font-weight: 600; }

        /* PERBAIKAN: Timer locked dan stabil */
        .timer-display { 
            text-align: center; 
            font-size: 1.8rem; 
            font-weight: 800; 
            color: var(--text-main); 
            background: white; 
            border-radius: 8px; 
            padding: 5px; 
            border: 1px solid #ddd;
            font-family: 'Courier New', Courier, monospace;
            font-variant-numeric: tabular-nums;
            min-width: 180px;
            display: inline-block;
        }

        /* OPERATOR STYLING */
        .operator-timer-container {
            text-align: center;
            padding: 20px;
            background: #2d3436;
            border-radius: 15px;
            margin-bottom: 20px;
        }
        .op-timer-val { 
            font-size: 4rem; 
            font-weight: 800; 
            color: #ffffff; 
            font-family: 'Courier New', Courier, monospace;
            font-variant-numeric: tabular-nums;
            min-width: 320px;
            display: inline-block;
        }
        .op-controls { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 20px; }
        .op-btn { padding: 15px; border: none; border-radius: 10px; color: white; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 1rem; }
        .op-go { background: var(--success); }
        .op-pause { background: var(--warning); color: #333; }
        .op-stop { background: var(--danger); }
        .op-action-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-bottom: 20px; }
        .op-btn-outline { background: white; color: var(--primary-color); border: 2px solid var(--primary-color); padding: 10px; border-radius: 10px; font-weight: 600; cursor: pointer; }
        .op-btn-outline:hover { background: var(--primary-color); color: white; }

        /* Status Buttons (Operator) */
        .status-btn-group { display: flex; gap: 4px; margin-top: 8px; }
        .status-btn {
            padding: 6px 4px;
            font-size: 0.6rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            cursor: pointer;
            background: #f8f9fa;
            font-weight: 700;
            flex: 1;
            transition: 0.3s;
            text-transform: uppercase;
        }
        .status-btn.active-ready { background: var(--info) !important; color: white !important; border-color: var(--info); box-shadow: 0 0 8px rgba(142, 68, 173, 0.4); }
        .status-btn.active-fight { background: var(--warning) !important; color: #333 !important; border-color: var(--warning); box-shadow: 0 0 8px rgba(241, 196, 15, 0.4); }
        .status-btn.active-finish { background: var(--success) !important; color: white !important; border-color: var(--success); box-shadow: 0 0 8px rgba(39, 174, 96, 0.4); }

        .op-side-actions { display: flex; gap: 4px; margin-top: 8px; }
        .btn-op-mini { padding: 5px; border-radius: 4px; border: none; color: white; cursor: pointer; font-size: 0.65rem; font-weight: 600; flex: 1; display: flex; align-items: center; justify-content: center; gap: 4px; }
        .btn-op-edit { background: var(--primary-color); }
        .btn-op-del { background: var(--danger); }

        .table-responsive { overflow-x: auto; margin-top: 15px; }
        .op-table { width: 100%; border-collapse: collapse; font-size: 0.75rem; min-width: 900px; }
        .op-table th { background: #f8f9fa; padding: 10px; text-align: left; border-bottom: 2px solid #dee2e6; color: var(--text-sub); }
        .op-table td { padding: 10px; border-bottom: 1px solid #eee; vertical-align: top; }
        .op-table tr:hover { background-color: #f1f7ff; }

        /* DEWAN PANEL */
        #dewan-section .control-buttons { 
            display: grid; 
            grid-template-columns: repeat(6, 1fr); 
            gap: 6px; 
            margin-bottom: 12px; 
        }
        .btn-ctl { padding: 10px 2px; border: none; border-radius: 8px; color: white; font-weight: 700; cursor: pointer; font-size: 0.65rem; text-transform: uppercase; }
        .btn-finish { background: var(--success); }
        .btn-next { background: var(--primary-color); }
        .btn-reset { background: var(--warning); color: #333; }
        .btn-ud { background: var(--info); }
        .btn-penalty { background: var(--text-sub); }
        .btn-danger { background: var(--danger); }

        .main-score-box { background: #f8f9fa; border-radius: 12px; padding: 8px; text-align: center; margin-bottom: 12px; border: 2px solid var(--secondary-color); }
        .score-value { font-size: 2.8rem; font-weight: 800; color: var(--primary-color); line-height: 1; font-variant-numeric: tabular-nums; }
        
        .judges-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 5px; margin-bottom: 12px; }
        .judge-box { background: #dfe6e9; color: var(--text-sub); border-radius: 6px; padding: 6px 2px; text-align: center; }
        .judge-box.active { background: var(--success); color: white; }
        .judge-box span { display: block; font-size: 0.5rem; font-weight: 600; }
        .judge-box strong { font-size: 0.8rem; display: block; }

        .stats-info { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; background: #f8f9fa; padding: 10px; border-radius: 10px; }

        /* Tabel Pengurangan Dewan */
        .dewan-penalty-table { width: 100%; border-collapse: collapse; margin-top: 15px; font-size: 0.7rem; border-radius: 10px; overflow: hidden; box-shadow: var(--shadow); }
        .dewan-penalty-table th { background: var(--dark); color: white; padding: 10px; text-align: left; }
        .dewan-penalty-table td { background: white; padding: 8px 10px; border-bottom: 1px solid #eee; }
        .btn-minus { background: var(--danger); color: white; border: none; padding: 4px 8px; border-radius: 4px; font-weight: 700; cursor: pointer; }

        /* SCOREBOARD STYLING */
        .scoreboard-panel { background: #1a1a2e; color: white; border-radius: 20px; padding: 20px; }
        .scoreboard-header { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px; margin-bottom: 15px; }
        .sb-title { grid-column: span 2; text-align: center; color: var(--secondary-color); font-weight: 700; letter-spacing: 2px; margin-bottom: 5px; }
        .sb-match-info { font-size: 0.8rem; opacity: 0.8; }
        .sb-athlete-name { font-size: 1.2rem; font-weight: 700; color: #fff; }
        .sb-contingent { color: var(--warning); font-weight: 600; font-size: 0.9rem; }
        
        .scoreboard-main-row { display: grid; grid-template-columns: 1.5fr 1fr; gap: 15px; align-items: center; margin-bottom: 20px; }
        .sb-score-container { background: rgba(255,255,255,0.05); border: 2px solid var(--primary-color); border-radius: 15px; padding: 15px; text-align: center; }
        .sb-score-label { font-size: 0.7rem; text-transform: uppercase; color: var(--secondary-color); font-weight: 600; }
        .sb-score-big { 
            font-size: 4rem; 
            font-weight: 800; 
            color: #fff; 
            text-shadow: 0 0 20px rgba(0,123,255,0.5); 
            line-height: 1; 
            font-variant-numeric: tabular-nums; 
        }
        
        .sb-timer { background: #000; border-radius: 10px; padding: 10px; text-align: center; border: 1px solid var(--danger); }
        .sb-timer-val { 
            font-size: 2.5rem; 
            font-weight: 800; 
            color: #ffffff !important; 
            line-height: 1; 
            font-family: 'Courier New', Courier, monospace; 
            font-variant-numeric: tabular-nums;
            min-width: 150px;
            display: inline-block;
        }
        .sb-timer-label { font-size: 0.6rem; color: #fff; opacity: 0.6; }

        .sb-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 20px; } 
        .sb-stat-box { background: rgba(255,255,255,0.05); padding: 10px; border-radius: 10px; text-align: center; border-bottom: 3px solid var(--primary-color); transition: 0.3s; }
        .sb-stat-box.pen { border-bottom-color: var(--danger); }
        .sb-stat-label { font-size: 0.55rem; text-transform: uppercase; opacity: 0.7; margin-bottom: 5px; display: block; }
        .sb-stat-val { font-size: 1.1rem; font-weight: 700; font-variant-numeric: tabular-nums; }

        .sb-judges-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
        .sb-judge-card { 
            background: rgba(255,255,255,0.08); 
            padding: 8px 2px; 
            border-radius: 8px; 
            text-align: center; 
            border: 1px solid rgba(255,255,255,0.1); 
            transition: all 0.3s ease; 
        }
