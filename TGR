        // FUNGSI IMPORT DATA DARI PDF 
        async function handleImportPDF(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = async function() {
                try {
                    const typedarray = new Uint8Array(this.result);
                    const pdfjsLib = window['pdfjs-dist/build/pdf'];
                    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
                    
                    const pdf = await pdfjsLib.getDocument(typedarray).promise;
                    let fullText = "";
                    
                    for (let i = 1; i <= pdf.numPages; i++) {
                        const page = await pdf.getPage(i);
                        const textContent = await page.getTextContent();
                        
                        // Ekstraksi text beserta koordinatnya
                        const items = textContent.items.map(item => ({
                            str: item.str,
                            x: item.transform[4],
                            y: item.transform[5]
                        }));
                        
                        // Urutkan block text secara vertikal dari atas ke bawah, lalu horizontal kiri ke kanan
                        items.sort((a, b) => {
                            if (Math.abs(a.y - b.y) > 5) return b.y - a.y;
                            return a.x - b.x;
                        });

                        let lastY = -1;
                        let line = "";
                        items.forEach(item => {
                            if (lastY !== -1 && Math.abs(lastY - item.y) > 5) {
                                fullText += line.trim() + "\n";
                                line = "";
                            }
                            // Tambahkan double spasi antar text block/cell sebagai pemisah kolom
                            line += item.str.trim() + "  ";
                            lastY = item.y;
                        });
                        fullText += line.trim() + "\n";
                    }
                    
                    parseAndImportMatches(fullText);
                } catch(e) {
                    alert("Error saat membaca file PDF: " + e.message);
                }
                event.target.value = ''; // reset input
            };
            reader.readAsArrayBuffer(file);
        }

        function parseAndImportMatches(text) {
            const lines = text.split('\n');
            const updates = {};
            let count = 0;
            let currentPartai = 1; // Fallback partai counter

            // Cari partai maksimum saat ini agar tidak tumpang tindih jika ada sinkronisasi parsial
            let maxPartai = 0;
            if(globalMatchData && globalMatchData.length > 0) {
                globalMatchData.forEach(m => {
                    if(parseInt(m.partai) > maxPartai) maxPartai = parseInt(m.partai);
                });
            }
            currentPartai = maxPartai + 1;

            lines.forEach(line => {
                line = line.trim();
                if(!line) return;
                
                // Coba pisahkan berdasarkan jarak yang lebar (khas tabel ekstraksi PDF)
                const parts = line.split(/\s{2,}/);
                
                let biru = "", kategori = "", merah = "";
                let found = false;

                // Jika terpisah dengan baik menjadi kolom-kolom tabel
                if (parts.length >= 3) {
                    // Cari kolom mana yang mengandung Keyword Kategori Seni TGR
                    let katIndex = -1;
                    for(let i=0; i<parts.length; i++) {
                        if(/Tunggal|Ganda|Regu|Solo Kreatif/i.test(parts[i])) {
                            katIndex = i;
                            break;
                        }
                    }
                    
                    if(katIndex > 0 && katIndex < parts.length - 1) {
                        biru = parts[katIndex - 1].trim();
                        kategori = parts[katIndex].trim();
                        merah = parts[katIndex + 1].trim();
                        found = true;
                    } else if (parts.length === 3) {
                        // Jika ada tepat 3 kolom terdeteksi, asumsikan (Bebas susunan tapi standar: Biru, Kat, Merah)
                        biru = parts[0].trim();
                        kategori = parts[1].trim();
                        merah = parts[2].trim();
                        found = true;
                    }
                }

                // Fallback pencarian Regex apabila spasi ganda gagal mendeteksi
                if (!found) {
                    const match = line.match(/(.*?)\s+(Tunggal Bebas|Tunggal|Ganda|Regu|Solo Kreatif)(.*?)\s+(.*)/i);
                    if (match) {
                        let b = match[1].trim();
                        // Hapus potensi noise No atau Partai di awal
                        b = b.replace(/^[\d\s]+/, '').trim();
                        if (b) {
                            biru = b;
                            kategori = (match[2] + (match[3]||'')).trim();
                            merah = match[4].trim();
                            found = true;
                        }
                    }
                }

                // Validasi data akhir & masukkan ke updates
                if (found && biru && kategori && merah && !/sudut/i.test(biru) && !/kategori/i.test(kategori)) {
                    let pNum = currentPartai;
                    // Coba mendeteksi nomor partai (misal No, Partai)
                    const partaiMatch = line.match(/^(\d+)\s+(\d+)/); 
                    if(partaiMatch) {
                        pNum = parseInt(partaiMatch[2]);
                        if(pNum >= currentPartai) currentPartai = pNum + 1;
                    } else {
                        const singleNum = line.match(/^(\d+)/);
                        if(singleNum) {
                            pNum = parseInt(singleNum[1]);
                            if(pNum >= currentPartai) currentPartai = pNum + 1;
                        } else {
                            pNum = currentPartai;
                            currentPartai++;
                        }
                    }

                    // Pembersihan string
                    biru = biru.replace(/^(biru|sudut biru)\s+/i, '');
                    merah = merah.replace(/^(merah|sudut merah)\s+/i, '');

                    updates['/matches/' + pNum + '/partai'] = pNum;
                    updates['/matches/' + pNum + '/namaBiru'] = biru;
                    updates['/matches/' + pNum + '/kategori'] = kategori;
                    updates['/matches/' + pNum + '/namaMerah'] = merah;
                    
                    // Fallback Default usia dan gender jika tidak tertera jelas
                    if(!updates['/matches/' + pNum + '/usia']) updates['/matches/' + pNum + '/usia'] = 'Dewasa';
                    if(!updates['/matches/' + pNum + '/gender']) updates['/matches/' + pNum + '/gender'] = 'Putra';
                    
                    count++;
                }
            });

            if(count > 0) {
                db.ref().update(updates).then(() => {
                    alert("Import Data PDF Berhasil! " + count + " baris pertandingan telah diimpor.");
                });
            } else {
                alert("Tidak ada data tabel yang cocok terdeteksi. Pastikan file PDF memuat informasi Kategori (Tunggal/Ganda/Regu).");
            }
        }

