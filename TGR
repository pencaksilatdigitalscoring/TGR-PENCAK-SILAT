        function toggleStamina(el) {
            const wasActive = el.classList.contains('active');
            document.querySelectorAll('#mode-tunggal-ui .stamina-item').forEach(item => item.classList.remove('active'));
            if (!wasActive) el.classList.add('active');
            calculateJuriScore();
        }

        function updateCounter(val) {
            currentWrongCount += val;
            document.getElementById('wrong-count').innerText = (currentWrongCount * 0.01).toFixed(2);
            calculateJuriScore();
        }

        function nextMove() {
            const kategori = (activeMatchInfo.kategori || '').toLowerCase();
            let maxJurus = 99; 
            if (kategori.includes('tunggal')) maxJurus = 14;
            else if (kategori.includes('regu')) maxJurus = 12;
            if (currentJurusCount < maxJurus) {
                currentJurusCount++;
                document.getElementById('jurus-count').innerText = currentJurusCount;
                calculateJuriScore();
            } else { alert("Maksimal jurus tercapai."); }
        }

        function calculateJuriScore() {
            if(!activeJuriId) return;
            let pen = (currentWrongCount * 0.01);
            let result = 0;
            let payload = { penalty: pen, jurus: currentJurusCount };
            
            if (currentJuriMode === 'tunggal') {
                let staminaAdd = 0;
                document.querySelectorAll('#mode-tunggal-ui .stamina-item.active').forEach(el => { staminaAdd = parseFloat(el.innerText); });
                result = 9.90 + staminaAdd - pen;
                payload.score = result;
                payload.stamina = staminaAdd;
            } else {
                result = 9.10 + gandaVals.kekayaan + gandaVals.kebenaran + gandaVals.stamina - pen;
                payload.score = result;
                payload.kekayaan = gandaVals.kekayaan;
                payload.kebenaran = gandaVals.kebenaran;
                payload.stamina = gandaVals.stamina;
            }

            document.getElementById('j-live-score').innerText = result.toFixed(2);
            db.ref('scores/juri' + activeJuriId).update(payload);
        }

        function finishMatch() {
            if(!activeMatchInfo.name) { alert("Pilih peserta dulu (Klik FIGHT pada daftar)!"); return; }
            if(confirm("Selesaikan pertandingan dan simpan ke rekapitulasi?")) {
                let mins = Math.floor(elapsedTime / 60000);
                let secs = Math.floor((elapsedTime % 60000) / 1000);
                let ms = Math.floor((elapsedTime % 1000) / 10);
                let formattedTime = (mins < 10 ? "0" + mins : mins) + ":" + (secs < 10 ? "0" + secs : secs) + "." + (ms < 10 ? "0" + ms : ms);

                const rekapObj = { partai: activeMatchInfo.partai, name: activeMatchInfo.name, cont: activeMatchInfo.cont, kategori: activeMatchInfo.kategori, median: globalMedian, stdev: globalStDev, final: finalScoreValue, waktu: formattedTime, timerMs: elapsedTime, timestamp: Date.now() };
                db.ref('rekap').push(rekapObj).then(() => { 
                    
                    // RESPONSIF: Update status tabel di Firebase secara otomatis
                    const sideField = activeMatchInfo.side === 'merah' ? 'redStatus' : 'blueStatus';
                    db.ref('matches/' + activeMatchInfo.partai).update({ [sideField]: 'finish' });

                    alert("Data berhasil disimpan ke Rekapitulasi!"); 
                    resetAll(true); 
                    stopTimer(); 
                    
                    db.ref('activeMatch').set({ partai: 0, side: '', name: '', cont: '', kategori: '', img: '' });
                });
            }
        }

        // Penghubung fungsi finish antara klik pada tabel dengan fungsi global finish. Keduanya kini terpadu.
        function handleTableFinish(partai, side) {
            const sideIndo = side === 'red' ? 'merah' : 'biru';
            if (activeMatchInfo.partai == partai && activeMatchInfo.side == sideIndo) {
                // Jika sudah aktif (FIGHT), langsung eksekusi finish.
                finishMatch();
            } else {
                // Jika belum FIGHT, peringatkan untuk di FIGHT-kan dahulu.
                alert("Harap set status ke FIGHT terlebih dahulu untuk peserta ini sebelum mengakhiri (FINISH) pertandingan.");
            }
        }

        function renderRekap() {
            const tbody = document.getElementById('rekap-table-body');
            if(globalRekapData.length === 0) { 
                tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; opacity:0.5; padding:40px;">Belum ada data rekapitulasi...</td></tr>'; 
                return; 
            }
            tbody.innerHTML = '';
            
            const groups = {};
            globalRekapData.forEach(item => {
                const groupKey = (item.kategori || '-').toUpperCase();
                if(!groups[groupKey]) groups[groupKey] = [];
                groups[groupKey].push(item);
            });
            
            for(const groupName in groups) {
                groups[groupName].sort((a, b) => {
                    const scoreA = typeof a.final === 'number' ? a.final : -999;
                    const scoreB = typeof b.final === 'number' ? b.final : -999;
                    
                    if(scoreA !== scoreB) {
                        return scoreB - scoreA;
                    } else {
                        const stdevA = a.stdev || 0;
                        const stdevB = b.stdev || 0;
                        if(stdevA !== stdevB) return stdevA - stdevB; 
                        const timeA = a.timerMs || 9999999;
                        const timeB = b.timerMs || 9999999;
                        return timeA - timeB; 
                    }
                });

                tbody.innerHTML += `<tr><td colspan="8" class="group-header">${groupName}</td></tr>`;
                
                groups[groupName].forEach((item, index) => {
                    const finalDisp = typeof item.final === 'number' ? item.final.toFixed(3) : item.final;
                    const waktuDisp = item.waktu || '00:00.00';
                    tbody.innerHTML += `
                        <tr>
                            <td style="text-align:center; font-weight:700; font-size:1.1rem; color:var(--primary-color);">${index + 1}</td>
                            <td>
                                <div style="font-weight:700;">${item.name}</div>
                                <div style="font-size:0.65rem; color:var(--text-sub);">${item.cont}</div>
                            </td>
                            <td style="font-size:0.75rem;">${item.kategori}</td>
                            <td style="font-family: monospace; font-size:0.85rem; font-weight:600;">${waktuDisp}</td>
                            <td>${item.median ? item.median.toFixed(2) : '0.00'}</td>
                            <td>${item.stdev ? item.stdev.toFixed(3) : '0.000'}</td>
                            <td style="font-weight:700; color:var(--primary-color); font-size:1.1rem;">${finalDisp}</td>
                            <td style="text-align:center;">
                                <button class="status-btn active-selesai" style="padding:5px; background:var(--danger)!important; color:white; border:none; border-radius:4px;" onclick="deleteRekapItem('${item.id}')"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    `;
                });
            }
        }

        function deleteRekapItem(id) { if(confirm("Hapus data rekap ini?")) db.ref('rekap/' + id).remove(); }
        function deleteAllRekap() { if(confirm("PERINGATAN! Hapus seluruh data rekapitulasi?")) db.ref('rekap').remove(); }
        
        function exportToExcel() { 
            if(globalRekapData.length === 0) return; 
            const wsData = [["PERINGKAT", "NAMA", "KONTINGEN", "KATEGORI", "WAKTU", "AVG/MED", "ST. DEV", "NILAI AKHIR"]]; 
            
            const groups = {};
            globalRekapData.forEach(item => {
                const groupKey = (item.kategori || '-').toUpperCase();
                if(!groups[groupKey]) groups[groupKey] = [];
                groups[groupKey].push(item);
            });
            
            for(const groupName in groups) {
                groups[groupName].sort((a, b) => {
                    const scoreA = typeof a.final === 'number' ? a.final : -999;
                    const scoreB = typeof b.final === 'number' ? b.final : -999;
                    if(scoreA !== scoreB) return scoreB - scoreA;
                    const stdevA = a.stdev || 0;
                    const stdevB = b.stdev || 0;
                    if(stdevA !== stdevB) return stdevA - stdevB;
                    return (a.timerMs || 9999999) - (b.timerMs || 9999999);
                });
                
                wsData.push([`KATEGORI: ${groupName}`, "", "", "", "", "", "", ""]);

                groups[groupName].forEach((item, index) => { 
                    const f = typeof item.final === 'number' ? item.final.toFixed(3) : item.final; 
                    const waktuDisp = item.waktu || '00:00.00';
                    wsData.push([index + 1, item.name, item.cont, item.kategori, waktuDisp, item.median ? item.median.toFixed(2) : '0.00', item.stdev ? item.stdev.toFixed(3) : '0.000', f]); 
                });
            }

            const wb = XLSX.utils.book_new(); 
            const ws = XLSX.utils.aoa_to_sheet(wsData); 
            XLSX.utils.book_append_sheet(wb, ws, "Rekap"); 
            XLSX.writeFile(wb, "Rekap_Scoring_TGR.xlsx"); 
        }

        function exportToPDF() { 
            if(globalRekapData.length === 0) return; 
            const { jsPDF } = window.jspdf; 
            const doc = new jsPDF(); 
            doc.text("REKAPITULASI NILAI DIGITAL SCORING TGR", 14, 15); 
            
            const tableBody = [];
            const groups = {};
            globalRekapData.forEach(item => {
                const groupKey = (item.kategori || '-').toUpperCase();
                if(!groups[groupKey]) groups[groupKey] = [];
                groups[groupKey].push(item);
            });
            
            for(const groupName in groups) {
                groups[groupName].sort((a, b) => {
                    const scoreA = typeof a.final === 'number' ? a.final : -999;
                    const scoreB = typeof b.final === 'number' ? b.final : -999;
                    if(scoreA !== scoreB) return scoreB - scoreA;
                    const stdevA = a.stdev || 0;
                    const stdevB = b.stdev || 0;
                    if(stdevA !== stdevB) return stdevA - stdevB;
                    return (a.timerMs || 9999999) - (b.timerMs || 9999999);
                });
                
                tableBody.push([{ content: groupName, colSpan: 6, styles: { fillColor: [45, 52, 54], textColor: [255, 255, 255], fontStyle: 'bold' } }]);
                
                groups[groupName].forEach((item, index) => { 
                    const f = typeof item.final === 'number' ? item.final.toFixed(3) : item.final; 
                    const waktuDisp = item.waktu || '00:00.00';
                    tableBody.push([index + 1, `${item.name}\n(${item.cont})`, waktuDisp, item.median ? item.median.toFixed(2) : '0.00', item.stdev ? item.stdev.toFixed(3) : '0.000', f]); 
                });
            }

            doc.autoTable({ 
                startY: 30, 
                head: [["PERINGKAT", "NAMA & KONTINGEN", "WAKTU", "AVG/MED", "ST. DEV", "TOTAL NILAI"]], 
                body: tableBody, 
                theme: 'striped', 
                headStyles: { fillColor: [0, 123, 255] } 
            }); 
            doc.save("Rekapitulasi_TGR.pdf"); 
        }

        function toggleLandscape() { if (!document.fullscreenElement) { document.documentElement.requestFullscreen(); if (screen.orientation && screen.orientation.lock) screen.orientation.lock('landscape').catch(e => {}); } else { if (document.exitFullscreen) document.exitFullscreen(); } }
