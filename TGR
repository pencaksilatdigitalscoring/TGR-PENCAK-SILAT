                font-size: 0.5rem !important;
                margin-bottom: 2px !important;
                margin-top: 2px !important;
            }
        }

        /* TAB LOTING STYLING */
        .loting-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            border-bottom: 2px solid #eee;
            padding-bottom: 10px;
        }
        .tab-btn {
            padding: 10px 20px;
            border: none;
            background: #eee;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            color: var(--text-sub);
            transition: 0.3s;
        }
        .tab-btn.active {
            background: var(--primary-color);
            color: white;
        }
        .tab-content {
